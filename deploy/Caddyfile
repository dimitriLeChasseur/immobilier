# Caddyfile de PRODUCTION — reverse proxy HTTPS vers le conteneur FastAPI.
#
# Activation (dans le .env du VPS) :
#   CADDYFILE=./deploy/Caddyfile
#   SITE_ADDRESS=api.mondomaine.fr     # le domaine doit déjà pointer vers l'IP du VPS
#   ACME_EMAIL=vous@mondomaine.fr      # contact Let's Encrypt (alertes d'expiration)
#
# Caddy obtient et renouvelle le certificat tout seul ; HTTP (80) est redirigé vers HTTPS.
#
# Derrière le proxy Cloudflare (enregistrement « proxied »), les défis ACME n'atteignent pas
# Caddy si le port 80 est fermé : TLS_MODE=origine sert le certificat d'origine Cloudflare
# (mode SSL « Full (strict) »), déposé dans deploy/certs/origine.pem et origine-cle.pem.
# Sans TLS_MODE, rien ne change (certificat Let's Encrypt).
# Différences avec infra/caddy/Caddyfile (développement) : le domaine est obligatoire, et
# seules l'API FastAPI et l'authentification Supabase sont exposées.
{
	email {$ACME_EMAIL}
}

(tls_acme) {
}

(tls_origine) {
	tls /etc/caddy/certs/origine.pem /etc/caddy/certs/origine-cle.pem
}

{$SITE_ADDRESS} {
	import tls_{$TLS_MODE:acme}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	# L'API ne reçoit que des requêtes légères.
	request_body {
		max_size 1MB
	}

	log {
		output stdout
		format json
	}

	@api path /api/* /health
	handle @api {
		reverse_proxy backend:8000 {
			# Flux d'audit (Server-Sent Events) : transmettre chaque évènement sans tampon.
			flush_interval -1
			# Un audit peut durer une vingtaine de secondes quand une source publique est lente.
			transport http {
				response_header_timeout 60s
			}
		}
	}

	# Supabase Auth (inscription, connexion, retour Google).
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle {
		respond "Not found" 404
	}
}
