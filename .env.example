# Modèle de configuration. Ne pas remplir à la main :
#   ./scripts/generate-env.sh            -> crée .env avec des secrets aléatoires
# puis ajuster la section "URLs" pour la production.

############
# URLs
############
APP_ENV=production

# Adresse servie par Caddy. ":80" = HTTP simple (local).
# En production : le nom de domaine pointant sur le VPS (TLS automatique).
SITE_ADDRESS=:80

# URL publique de l'API (schéma inclus), telle que vue par le navigateur.
PUBLIC_URL=http://localhost

# URL du frontend (Netlify/Vercel) : redirections Auth et CORS.
SITE_URL=http://localhost:5173
# Adresses de retour autorisées après connexion (dont Google), séparées par des virgules.
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/**
CORS_ALLOWED_ORIGINS=http://localhost:5173

HTTP_PORT=80
HTTPS_PORT=443

# Fichier de configuration de Caddy. Production : ./deploy/Caddyfile (HTTPS, API seule).
CADDYFILE=./infra/caddy/Caddyfile
# Adresse de contact Let's Encrypt (production uniquement).
ACME_EMAIL=

############
# Secrets (générés)
############
POSTGRES_PASSWORD=
IMMO_APP_DB_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=
SONAR_DB_PASSWORD=

############
# Base de données
############
POSTGRES_DB=postgres
# Port publié sur 127.0.0.1 uniquement (5432 est déjà pris par cve-alert-engine)
DB_HOST_PORT=5433
# Répertoire des données persistantes (VPS : /srv/immo)
DATA_DIR=./data
PGRST_DB_SCHEMAS=public

############
# Auth
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# true = pas d'e-mail de confirmation. À repasser à false dès que le SMTP est configuré.
# true : les comptes sont actifs sans confirmation (développement, ou production sans
# serveur SMTP). false : un e-mail de confirmation est exigé ; il faut alors un serveur SMTP.
ENABLE_EMAIL_AUTOCONFIRM=true
# Adresse d'expédition des e-mails (confirmation de compte, reçus de paiement).
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="Audit Immobilier"

# Connexion « Continuer avec Google » : identifiants OAuth créés dans Google Cloud Console,
# avec pour URI de redirection autorisée : <PUBLIC_URL>/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

############
# Paiement Stripe
############
# Clé secrète (sk_test_... en test, sk_live_... en production) : Developers > API keys.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...) : fourni par `stripe listen` en local, ou par
# Developers > Webhooks en production, pour l'adresse <PUBLIC_URL>/api/v1/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Facultatif : identifiant d'un taux de TVA Stripe (txr_...) ajouté au prix de l'offre Pro.
STRIPE_PRO_TAX_RATE_ID=

############
# Sources optionnelles
############
# Clé OpenRouteService (gratuite sur inscription) : temps de marche calculés sur itinéraire
# piéton. Laisser vide pour conserver l'estimation à vol d'oiseau (détour de 30 %).
ORS_API_KEY=

############
# Outils d'administration (127.0.0.1 uniquement)
############
STUDIO_HOST_PORT=3100
SONAR_HOST_PORT=9000

############
# SonarQube (renseignés par ./scripts/sonar-setup.sh)
############
SONAR_ADMIN_PASSWORD=
SONAR_TOKEN=

############
# Sauvegardes hors site (Cloudflare R2)
############
# Renseignés, ils font envoyer chaque sauvegarde sur R2 en plus du disque du serveur.
# Jeton R2 limité à ce bucket, en lecture et écriture d'objets.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Phrase de chiffrement des copies hors site (openssl rand -base64 32). À CONSERVER AUSSI
# HORS DU SERVEUR : sans elle, ces copies sont illisibles.
BACKUP_PASSPHRASE=

############
# Anti-robot et rapport d'exemple
############
# Cloudflare Turnstile sur l'inscription et la connexion. À activer avec la clé publique
# VITE_TURNSTILE_SITE_KEY du frontend, jamais l'un sans l'autre.
CAPTCHA_ENABLED=false
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Identifiant BAN de l'adresse dont le rapport complet est ouvert à tous (page d'exemple).
DEMO_ADDRESS_ID=

############
# Alertes d'exploitation
############
# Destinataire des e-mails envoyés quand une tâche planifiée échoue (sauvegarde, test de fumée…).
ALERT_EMAIL=
