VITE_API_URL=http://localhost
# Adresse publique du site, sans barre finale (ex. https://mondomaine.fr). Sert aux URL
# canoniques, au plan du site et au robots.txt ; vide en développement.
VITE_SITE_URL=
# Clé publique « anon » de Supabase (valeur de ANON_KEY dans le .env racine) : nécessaire
# pour la création de compte et la connexion. Ce n'est pas un secret.
VITE_SUPABASE_ANON_KEY=
# Clé publique du défi anti-robot Cloudflare Turnstile. Vide : aucun défi. À ne renseigner
# qu'avec CAPTCHA_ENABLED=true côté serveur (et inversement), sinon la connexion échoue.
# En production, elle vient de .env.production.
VITE_TURNSTILE_SITE_KEY=
