# En-têtes servis par Cloudflare Pages.
# __API_ORIGIN__ est remplacé à la construction (scripts/seo.ts) par l'origine de
# VITE_API_URL, la variable définie dans le projet Pages.
# Origines Cloudflare autorisées : challenges.cloudflare.com (défi anti-robot Turnstile de
# l'inscription) et cloudflareinsights.com (mesure d'audience sans cookie).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://data.geopf.fr; connect-src 'self' https://api-adresse.data.gouv.fr https://cloudflareinsights.com __API_ORIGIN__; frame-src https://challenges.cloudflare.com; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
